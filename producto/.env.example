# Copia este archivo como ".env" (en esta misma carpeta) y cambia los valores. El archivo .env NO se sube a git.

# --- PostgreSQL (el mismo que usas desde pgAdmin) ---
DB_NAME=inventario
DB_USER=inventario_app
DB_PASSWORD=cambia-esta-contrasena
DB_HOST=localhost
DB_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=pon-aqui-una-cadena-larga-y-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Rutas de datos (opcionales: si no las pones, se buscan las carpetas "laboratorio" y "m5-forecasting-accuracy" junto a "producto") ---
# M5_DIR=C:\ruta\m5-forecasting-accuracy
# LAB_DIR=C:\ruta\laboratorio
# TABLA_MAESTRA=C:\ruta\laboratorio\datos_completa\tabla_maestra_alfa.parquet
# SERIES_CSV=C:\ruta\laboratorio\datos_completa\series_alfa.csv
# RESULTADOS_LAB=C:\ruta\laboratorio\resultados_publicados      # métricas del laboratorio, para la pestaña Modelos
# MODELOS_DIR=C:\ruta\donde\guardar\los\modelos
# LOGS_DIR=C:\ruta\donde\guardar\los\registros\de\tareas
